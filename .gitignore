# ---------------------------------------------------------------------------
# Build artifacts (regenerable via scripts/build/*.bat)
#
# Anchored to the repository root on purpose: an unanchored `build/` also
# swallows scripts/build/, which holds versioned build scripts.
# ---------------------------------------------------------------------------
/build/
*.exe
*.obj
*.pdb
*.ilk
*.lib
*.exp
*.res
*.nativecodeanalysis.xml
*.nativecodeanalysis.xml.filter

# Profile-guided optimization profiles
*.pgc
*.pgd
*.pgt

# ---------------------------------------------------------------------------
# Benchmark scratch output
#
# Probe captures and local benchmark audit output are regenerable and kept
# outside version control. Curated benchmark results under benchmarks/results/
# remain versioned unless explicitly ignored below.
# ---------------------------------------------------------------------------
.mph_*.tmp
*.tmp
benchmarks/audit_logs/
benchmarks/results/benchmark_v2_*.txt

# ---------------------------------------------------------------------------
# Superseded implementations and throwaway scratch code (kept on disk, not
# versioned)
# ---------------------------------------------------------------------------
archive/

# ---------------------------------------------------------------------------
# Agent workspace (project memory and session state)
# ---------------------------------------------------------------------------
.workbuddy-ai/

# Local research papers, mirrors, and extracted source material
/Research/

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.vs/
*.user
*.suo
